# Secrets
.env
.env.*
!.env.example

# JavaScript
node_modules/
.next/
dist/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# Python
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.py[cod]

# Data caches and generated warehouses
data/raw/**
data/staged/**
data/curated/**
warehouse/*.duckdb
warehouse/*.duckdb.wal
!data/raw/.gitkeep
!data/staged/.gitkeep
!data/curated/.gitkeep

# http_fetch.py's checksum-keyed raw-download cache (sources/manifest.py) --
# real fetched artifacts, some 100MB+, never committed.
cache/

# Generated reports / uploads
uploads/
exports/
tmp/

# OS/editor
.DS_Store
.vscode/
.idea/

# Local agent/session settings (machine-specific, never shared)
.claude/

# Logs
*.log
logs/
