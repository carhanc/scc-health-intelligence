# Santa Clara Health Intelligence — environment variable names only, no values.
# Copy to .env.local for local development. Never commit .env.local.
# Core platform functionality works with NONE of these set.

# --- Optional: faster/targeted ACS queries (keyless bulk-download fallback is the default) ---
CENSUS_API_KEY=

# --- Optional: higher-confidence ZIP-to-tract crosswalk (keyless Census ZCTA relationship file is the default) ---
HUD_USER_TOKEN=

# --- Optional: grounded LLM Copilot mode (deterministic mode is the default and always available) ---
ANTHROPIC_API_KEY=
# --- Optional: overrides the default Anthropic model used when ANTHROPIC_API_KEY is set ---
ANTHROPIC_MODEL=

# --- Optional: alternate basemap tiles (keyless MapLibre style is the default) ---
MAPBOX_TOKEN=

# --- Optional: enhanced routing (local OSM-network routing is the default) ---
OPENROUTESERVICE_API_KEY=

# --- Optional: hosted-mode error telemetry (no telemetry by default) ---
SENTRY_DSN=

# --- Local paths / runtime (defaults are usually fine) ---
SCC_HEALTH_DATA_DIR=./data
SCC_HEALTH_WAREHOUSE_PATH=./warehouse/scc_health.duckdb
SCC_HEALTH_API_PORT=8000
SCC_HEALTH_WEB_PORT=3000
