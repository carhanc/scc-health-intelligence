# Santa Clara Health Intelligence — environment variable names only, no values.
# Copy to .env.local for local development. Never commit .env.local.
# Core platform functionality works with NONE of these set.

# --- Optional: faster/targeted ACS queries (keyless bulk-download fallback is the default) ---
CENSUS_API_KEY=

# --- Optional: higher-confidence ZIP-to-tract crosswalk (keyless Census ZCTA relationship file is the default) ---
HUD_USER_TOKEN=

# --- Optional: grounded LLM Copilot mode (deterministic mode is the default and always available) ---
ANTHROPIC_API_KEY=
# --- Optional: overrides the default Anthropic model used when ANTHROPIC_API_KEY is set ---
ANTHROPIC_MODEL=

# --- Optional: alternate basemap tiles (keyless MapLibre style is the default) ---
MAPBOX_TOKEN=

# --- Optional: enhanced routing (local OSM-network routing is the default) ---
OPENROUTESERVICE_API_KEY=

# --- Optional: hosted-mode error telemetry (no telemetry by default) ---
# Backend (FastAPI, server-side only):
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Frontend server-side (Next.js instrumentation.ts, server-side only):
# (SENTRY_DSN/SENTRY_ENVIRONMENT above are reused for this if set in the
# web app's own environment -- Vercel project env vars are separate from
# the API's.)
# Frontend browser-side (Next.js instrumentation-client.ts) -- must be
# NEXT_PUBLIC_-prefixed to reach the browser bundle; this is a project ID,
# not a secret, but is still opt-in/unset by default:
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# --- Production hardening (Phase 9); local dev defaults shown are safe ---
# "local" (default) or "production". production additionally requires the
# live warehouse to exist at API startup -- see settings.py.
SCC_HEALTH_ENVIRONMENT=local
# Comma-separated list of frontend origins allowed to call the API.
# Defaults to the local Next.js dev server only; a hosted deployment must
# set this to its real frontend URL(s), never a wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Comma-separated list of Host header values the API will accept.
# "*" (default) is fine for local dev; set to the real backend domain in
# a hosted deployment.
TRUSTED_HOSTS=*
# The API's own base URL, read by the frontend (browser-safe, not a
# secret) -- must point at the deployed backend in production.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Local paths / runtime (defaults are usually fine) ---
SCC_HEALTH_DATA_DIR=./data
SCC_HEALTH_WAREHOUSE_PATH=./warehouse/scc_health.duckdb
SCC_HEALTH_API_PORT=8000
SCC_HEALTH_WEB_PORT=3000

# --- Phase 9 production data artifact (see docs/deployment/production-deployment-guide.md) ---
# The GitHub Release tag published by scripts/publish_data_artifact.py,
# fetched by scripts/fetch_data_artifact.py during the backend's build step.
DATA_ARTIFACT_RELEASE_TAG=
